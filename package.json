{
	"name": "maplibre-solidjs",
	"version": "0.2.0",
	"description": "SolidJS 2 components for MapLibre GL JS.",
	"type": "module",
	"license": "MIT OR Apache-2.0",
	"author": "Benjamin Lucier",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BenjaminLucier/maplibre-solidjs.git"
	},
	"bugs": {
		"url": "https://github.com/BenjaminLucier/maplibre-solidjs/issues"
	},
	"homepage": "https://benjaminlucier.github.io/maplibre-solidjs/",
	"keywords": [
		"solid",
		"solidjs",
		"maplibre",
		"maplibre-gl",
		"map",
		"gis"
	],
	"sideEffects": false,
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist",
		"LICENSE-MIT",
		"LICENSE-APACHE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json",
		"typecheck": "tsc -b",
		"lint": "biome check",
		"format": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"site:dev": "pnpm --filter maplibre-solidjs-site dev",
		"site:build": "pnpm --filter maplibre-solidjs-site build"
	},
	"peerDependencies": {
		"@solidjs/web": "^2.0.0",
		"maplibre-gl": "^6.16.0",
		"solid-js": "^2.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@solidjs/vite-plugin": "catalog:",
		"@solidjs/web": "catalog:",
		"@types/geojson": "^7946.0.16",
		"@vitest/browser-playwright": "^5.1.0",
		"maplibre-gl": "catalog:",
		"playwright": "1.65.1",
		"solid-js": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "^5.1.0"
	}
}
